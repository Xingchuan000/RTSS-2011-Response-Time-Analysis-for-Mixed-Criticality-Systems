{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formal-toolchain/specs/certificates/reference_model_conformance.schema.json",
  "allOf": [
    {"$ref": "https://formal-toolchain/specs/certificates/common_certificate.schema.json"},
    {
      "properties": {
        "obligation_id": {"const": "REFERENCE_MODEL_CONFORMANCE"},
        "inputs": {
          "type": "object",
          "required": ["reference_taskset_fingerprint", "imported_theorem_id", "imported_theorem_statement_hash", "conformance_contract_hash"],
          "properties": {
            "imported_theorem_id": {"type": "string"},
            "imported_theorem_statement_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "reference_taskset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "conformance_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "witness": {
          "type": "object",
          "required": ["contract_version", "contract_hash", "imported_theorem_id", "imported_theorem_statement_hash", "condition_ids", "condition_results", "all_conditions_covered", "exact_predecessor_set", "reference_taskset_fingerprint", "conformance_hash"],
          "properties": {
            "contract_version": {"type": "string"},
            "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "imported_theorem_id": {"type": "string"},
            "imported_theorem_statement_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "condition_ids": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true},
            "condition_results": {
              "type": "array", "minItems": 14, "maxItems": 14,
              "items": {
                "type": "object",
                "required": ["condition_id", "passed", "source_kind", "predecessor_ids", "predecessor_hashes", "predecessor_context_layers", "predecessor_context_hashes", "direct_check"],
                "properties": {
                  "condition_id": {"type": "string"},
                  "passed": {"type": "boolean"},
                  "source_kind": {"enum": ["DIRECT_RECOMPUTATION", "VERIFIED_PREDECESSORS", "HYBRID"]},
                  "predecessor_ids": {"type": "array", "uniqueItems": true},
                  "predecessor_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
                  "predecessor_context_layers": {"type": "object", "additionalProperties": {"type": "string"}},
                  "predecessor_context_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
                  "direct_check": {"type": ["object", "null"]}
                }
              }
            },
            "all_conditions_covered": {"const": true},
            "exact_predecessor_set": {"type": "array", "uniqueItems": true},
            "reference_taskset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "conformance_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    }
  ]
}
