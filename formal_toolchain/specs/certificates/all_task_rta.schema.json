{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formal-toolchain/specs/certificates/all_task_rta.schema.json",
  "allOf": [
    {"$ref": "https://formal-toolchain/specs/certificates/common_certificate.schema.json"},
    {
      "properties": {
        "obligation_id": {"const": "ALL_TASK_REFERENCE_RTA_ARITHMETIC"},
        "witness": {
          "type": "object",
          "required": [
            "schema_version", "task_count_expected", "task_count_analyzed",
            "all_tasks_covered", "all_deadlines_met", "tasks"
          ],
          "properties": {
            "schema_version": {"const": "all_task_rta_v3"},
            "all_tasks_covered": {"type": "boolean", "const": true},
            "all_deadlines_met": {"type": "boolean", "const": true},
            "tasks": {"type": "array", "minItems": 1}
          },
          "patternProperties": {
            "^task_": {}
          }
        }
      },
      "required": ["obligation_id", "witness"]
    }
  ]
}
