      "schema_version": "nonvacuity_mutation_v1",
      "enabled": false,
      "mutation_id": "P3_s397_balanced_base",
      "mutation_class": "BASELINE",
      "base_seed": 397,
      "seed_dir": "../../s397",
      "tree_variant": "best_balanced",
      "mutator": {"kind": "baseline", "parameters": {}},
      "expected": {"result_status": "DEPLOYED_TREE_PROVED"},
      "metadata": {"required_input_unavailable": "s397"}
