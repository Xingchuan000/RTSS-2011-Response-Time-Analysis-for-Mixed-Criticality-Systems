{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ppp_nonvacuity_campaign_v1",
  "title": "PPP non-vacuity campaign",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "proof_route",
    "output_root",
    "source_root",
    "mutations"
  ],
  "properties": {
    "extends": {"type": "string", "minLength": 1},
    "schema_version": {"const": "ppp_nonvacuity_campaign_v1"},
    "enabled": {"type": "boolean", "default": false},
    "campaign_id": {"type": "string", "minLength": 1},
    "proof_route": {"const": "protected_prefix"},
    "output_root": {"type": "string", "minLength": 1},
    "source_root": {"type": "string", "minLength": 1},
    "preserve_workspaces": {"type": "boolean", "default": true},
    "run_baselines": {"type": "boolean", "default": true},
    "run_semantic_recompile": {"type": "boolean", "default": true},
    "run_integrity_reuse": {"type": "boolean", "default": true},
    "run_hout": {"type": "boolean", "default": true},
    "fail_on_not_activated": {"type": "boolean", "default": true},
    "mutations": {
      "type": "array",
      "items": {"$ref": "#/$defs/mutation"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mutation": {
      "type": "object",
      "required": [
        "schema_version",
        "mutation_id",
        "mutation_class",
        "tree_variant",
        "mutator"
      ],
      "properties": {
        "schema_version": {"const": "nonvacuity_mutation_v1"},
        "enabled": {"type": "boolean", "default": false},
        "mutation_id": {"type": "string", "minLength": 1},
        "mutation_class": {
          "enum": [
            "BASELINE",
            "DANGEROUS_TOP1",
            "MASK_BYPASS",
            "NO_FIRST_VALID",
            "ALL_INVALID_FORCE_TOP1",
            "GUARD_ABLATION",
            "ACTION_SEMANTICS",
            "RUNTIME_SOURCE",
            "ENVELOPE",
            "BUNDLE_INTEGRITY"
          ]
        },
        "base_seed": {"type": "integer"},
        "seed_dir": {"type": "string"},
        "tree_variant": {
          "enum": ["best_overall", "best_balanced", "best_performance"]
        },
        "paired_with": {"type": "string"},
        "single_semantic_change": {"type": "boolean", "default": true},
        "mutator": {"type": "object"},
        "activation": {"type": "object"},
        "expected": {"type": "object"},
        "reuse_source_bundle": {"type": "string"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
