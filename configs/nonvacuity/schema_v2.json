{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nonvacuity_campaign_v2",
  "type": "object",
  "required": ["schema_version", "config_kind", "campaign_id", "proof_route", "enabled", "source_binding", "mutations"],
  "properties": {
    "schema_version": {"const": "nonvacuity_campaign_v2"},
    "config_kind": {"enum": ["TEMPLATE", "RESOLVED"]},
    "campaign_id": {"type": "string", "minLength": 1},
    "proof_route": {"const": "protected_prefix"},
    "enabled": {"type": "boolean", "default": false},
    "paper_mode": {"type": "boolean", "default": false},
    "source_binding": {"type": "object", "required": ["clean_source_root", "clean_source_root_sha256"]},
    "resolver_receipt": {"type": "object"},
    "hout_profiles": {"type": "object"},
    "mutations": {"type": "array", "items": {"type": "object", "required": ["mutation_id", "mutation_class", "enabled"]}},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
